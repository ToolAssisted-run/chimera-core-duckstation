diff --git a/src/core/gpu.h b/src/core/gpu.h
index 76cb876..71632c7 100644
--- a/src/core/gpu.h
+++ b/src/core/gpu.h
@@ -176,6 +176,41 @@ public:
   float ComputeVerticalFrequency() const;
   float ComputeDisplayAspectRatio() const;
 
+#ifdef CHIMERA_WATERBOX
+  // The frame as the console put it out, for a frontend that reads it rather
+  // than presenting it: the display texture and the part of it in view, and
+  // where that rectangle sits in the raster the video mode describes.
+  struct ChimeraDisplay
+  {
+    GPUTexture* texture;
+    s32 view_x, view_y, view_width, view_height;
+    u32 display_width, display_height;
+    u32 origin_left, origin_top;
+    u32 vram_width, vram_height;
+    u32 horizontal_total, vertical_total;
+    u32 field;
+    bool interlaced;
+  };
+  void ChimeraGetDisplay(ChimeraDisplay* out) const
+  {
+    out->texture = m_display_texture;
+    out->view_x = m_display_texture_view_x;
+    out->view_y = m_display_texture_view_y;
+    out->view_width = m_display_texture_view_width;
+    out->view_height = m_display_texture_view_height;
+    out->display_width = m_crtc_state.display_width;
+    out->display_height = m_crtc_state.display_height;
+    out->origin_left = m_crtc_state.display_origin_left;
+    out->origin_top = m_crtc_state.display_origin_top;
+    out->vram_width = m_crtc_state.display_vram_width;
+    out->vram_height = m_crtc_state.display_vram_height;
+    out->horizontal_total = m_crtc_state.horizontal_total;
+    out->vertical_total = m_crtc_state.vertical_total;
+    out->field = GetInterlacedDisplayField();
+    out->interlaced = IsInterlacedDisplayEnabled();
+  }
+#endif
+
   static std::unique_ptr<GPU> CreateHardwareRenderer();
   static std::unique_ptr<GPU> CreateSoftwareRenderer();
 
diff --git a/src/core/settings.cpp b/src/core/settings.cpp
