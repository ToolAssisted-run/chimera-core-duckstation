--- a/src/core/settings.cpp
+++ b/src/core/settings.cpp
@@ -1135,7 +1135,14 @@ RenderAPI Settings::GetRenderAPIForRenderer(GPURenderer renderer)
     case GPURenderer::HardwareOpenGL:
       return RenderAPI::OpenGL;
 #endif
+#ifdef CHIMERA_WATERBOX
+    // The software renderer needs a device only to hold the picture it has
+    // already drawn, and in a sandbox that device is memory.
     case GPURenderer::Software:
+      return RenderAPI::None;
+#else
+    case GPURenderer::Software:
+#endif
     case GPURenderer::Automatic:
     default:
       return GPUDevice::GetPreferredAPI();
