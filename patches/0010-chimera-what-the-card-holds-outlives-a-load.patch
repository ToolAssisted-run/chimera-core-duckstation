+#ifdef CHIMERA_WATERBOX
+void GPU_HW::ChimeraVRAMTextureSize(u32* width, u32* height) const
+{
+  *width = m_vram_texture ? m_vram_texture->GetWidth() : 0;
+  *height = m_vram_texture ? m_vram_texture->GetHeight() : 0;
+}
+
+bool GPU_HW::ChimeraDownloadVRAMTexture(void* rgba, u32 pitch)
+{
+  if (!m_vram_texture || m_vram_texture->IsMultisampled())
+    return false;
+
+  FlushRender();
+
+  const u32 width = m_vram_texture->GetWidth();
+  const u32 height = m_vram_texture->GetHeight();
+  std::unique_ptr<GPUDownloadTexture> dl =
+    g_gpu_device->CreateDownloadTexture(width, height, m_vram_texture->GetFormat(), rgba,
+                                        static_cast<size_t>(pitch) * height, pitch);
+  if (!dl)
+    return false;
+
+  dl->CopyFromTexture(0, 0, m_vram_texture.get(), 0, 0, width, height, 0, 0, false);
+  dl->Flush();
+  RestoreDeviceContext();
+  return true;
+}
+
+void GPU_HW::ChimeraUploadVRAMTexture(const void* rgba, u32 pitch)
+{
+  if (!m_vram_texture || m_vram_texture->IsMultisampled())
+    return;
+
+  m_vram_texture->Update(0, 0, m_vram_texture->GetWidth(), m_vram_texture->GetHeight(), rgba, pitch);
+
+  // what loading a state does after it has put VRAM back
+  if (m_pgxp_depth_buffer)
+    ClearDepthBuffer();
+  else if (m_write_mask_as_depth)
+    UpdateDepthBufferFromMaskBit();
+  ClearVRAMDirtyRectangle();
+  SetFullVRAMDirtyRectangle();
+  ResetBatchVertexDepth();
+  RestoreDeviceContext();
+}
+#endif
