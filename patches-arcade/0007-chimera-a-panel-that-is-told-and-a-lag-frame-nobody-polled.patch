+void ChimeraSetDigital(u32 port, std::string_view key, bool pressed)
+{
+  const std::optional<Control> control = GetControl(key);
+  if (port >= s_ports.size() || !control.has_value())
+    return;
+
+  bool held;
+  {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    held = IsPressed(s_ports[port], control.value());
+  }
+  // OnDigital counts presses, because several host bindings may hold one
+  // control down; here there is one voice, so the count is 0 or 1
+  if (held != pressed)
+    OnDigital(port, control.value(), pressed ? 1 : 0);
+}
+
+void ChimeraSetOperator(std::string_view key, bool pressed)
+{
+  OperatorControl control;
+  if (key == "Service")
+    control = OperatorControl::Service;
+  else if (key == "Test")
+    control = OperatorControl::Test;
+  else
+    return;
+
+  bool held;
+  {
+    std::lock_guard<std::mutex> lock(s_mutex);
+    held = s_operator.pressed_counts[static_cast<u32>(control)] != 0;
+  }
+  if (held != pressed)
+    OnOperatorDigital(control, pressed ? 1 : 0);
+}
+
+void ChimeraSetGun(u32 port_index, float x, float y, bool offscreen)
+{
+  std::lock_guard<std::mutex> lock(s_mutex);
+  if (port_index >= s_ports.size())
+    return;
+  PortState& port = s_ports[port_index];
+  if (port.type != Arcade::ArcadeControllerType::Lightgun || port_index >= (Konami::IsGQActive() ? 3U : 2U))
+    return;
+
+  port.lightgun_offscreen = offscreen;
+  port.axis_x = std::clamp(x, 0.0f, 1.0f);
+  port.axis_y = std::clamp(y, 0.0f, 1.0f);
+  port.lightgun_x = port.axis_x;
+  port.lightgun_y = port.axis_y;
+  if (Konami::IsGQActive())
+    Konami::SetGQLightgunPosition(port_index, port.lightgun_x, port.lightgun_y);
+  else
+    Konami::SetGVLightgunPosition(port_index, port.lightgun_x, port.lightgun_y);
+  ApplyPort(port_index);
+}
