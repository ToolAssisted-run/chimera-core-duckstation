+#ifdef CHIMERA_GUEST_VK
+// chimera: the Vulkan device needs its GLSL made into SPIR-V. Upstream asks
+// shaderc, a shared library it loads at run time; a sandbox loads nothing,
+// so glslang - the compiler shaderc is a wrapper of - is compiled into the
+// core and asked directly. Without shaderc's optimiser: the shaders are a
+// few dozen lines each and the driver compiles them again anyway.
+#include "SPIRV/GlslangToSpv.h"
+#include "glslang/Public/ResourceLimits.h"
+#include "glslang/Public/ShaderLang.h"
+
+#include <string>
+#include <unordered_map>
+#include <vector>
+
+bool GPUDevice::CompileGLSLShaderToVulkanSpv(GPUShaderStage stage, GPUShaderLanguage source_language,
+                                             std::string_view source, const char* entry_point, bool optimization,
+                                             bool nonsemantic_debug_info, DynamicHeapArray<u8>* out_binary,
+                                             Error* error)
+{
+  static constexpr const std::array<EShLanguage, static_cast<size_t>(GPUShaderStage::MaxCount)> stage_kinds = {{
+    EShLangVertex,
+    EShLangFragment,
+    EShLangGeometry,
+    EShLangCompute,
+  }};
+
+  if (source_language != GPUShaderLanguage::GLSLVK)
+  {
+    Error::SetStringFmt(error, "Unsupported source language for transpile: {}",
+                        ShaderLanguageToString(source_language));
+    return false;
+  }
+
+  // What was compiled once is kept, by stage and source. After every
+  // savestate that is loaded the device is made again and asks for the same
+  // few dozen shaders; compiling them again was most of what a load cost.
+  // The table is the core's own memory, so a state carries it.
+  static std::unordered_map<std::string, std::vector<unsigned int>> s_compiled;
+  std::string key;
+  key.reserve(source.length() + 1);
+  key.push_back(static_cast<char>('0' + static_cast<int>(stage)));
+  key.append(source);
+  if (const auto it = s_compiled.find(key); it != s_compiled.end())
+  {
+    out_binary->resize(it->second.size() * sizeof(unsigned int));
+    std::memcpy(out_binary->data(), it->second.data(), out_binary->size());
+    return true;
+  }
+
+  static bool s_glslang_started = false;
+  if (!s_glslang_started)
+  {
+    glslang::InitializeProcess();
+    s_glslang_started = true;
+  }
+
+  const EShLanguage kind = stage_kinds[static_cast<size_t>(stage)];
+  const char* const text = source.data();
+  const int length = static_cast<int>(source.length());
+  const EShMessages messages = static_cast<EShMessages>(EShMsgSpvRules | EShMsgVulkanRules);
+
+  glslang::TShader shader(kind);
+  shader.setStringsWithLengths(&text, &length, 1);
+  shader.setEnvInput(glslang::EShSourceGlsl, kind, glslang::EShClientVulkan, 100);
+  shader.setEnvClient(glslang::EShClientVulkan, glslang::EShTargetVulkan_1_0);
+  shader.setEnvTarget(glslang::EShTargetSpv, glslang::EShTargetSpv_1_0);
+  if (!shader.parse(GetDefaultResources(), 110, false, messages))
+  {
+    const std::string_view errors(shader.getInfoLog());
+    Error::SetStringFmt(error, "Failed to compile shader to SPIR-V:\n{}", errors);
+    ERROR_LOG("Failed to compile shader to SPIR-V:\n{}", errors);
+    DumpBadShader(source, errors);
+    return false;
+  }
+
+  glslang::TProgram program;
+  program.addShader(&shader);
+  if (!program.link(messages))
+  {
+    const std::string_view errors(program.getInfoLog());
+    Error::SetStringFmt(error, "Failed to link shader for SPIR-V:\n{}", errors);
+    ERROR_LOG("Failed to link shader for SPIR-V:\n{}", errors);
+    DumpBadShader(source, errors);
+    return false;
+  }
+
+  std::vector<unsigned int> words;
+  glslang::SpvOptions options;
+  options.disableOptimizer = true;
+  glslang::GlslangToSpv(*program.getIntermediate(kind), words, &options);
+  if (words.empty())
+  {
+    Error::SetStringView(error, "glslang wrote no SPIR-V for a shader it accepted");
+    return false;
+  }
+
+  out_binary->resize(words.size() * sizeof(unsigned int));
+  std::memcpy(out_binary->data(), words.data(), out_binary->size());
+  s_compiled.emplace(std::move(key), std::move(words));
+  return true;
+}
+
