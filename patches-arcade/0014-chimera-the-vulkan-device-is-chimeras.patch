+bool Vulkan::LoadVulkanLibrary(Error* error)
+{
+  bool required_functions_missing = false;
+
+#define VULKAN_MODULE_ENTRY_POINT(name, required)                                                                      \
+  name = reinterpret_cast<PFN_##name>(chimera_vk_lookup(#name));                                                       \
+  if (!name && required)                                                                                               \
+  {                                                                                                                    \
+    ERROR_LOG("Vulkan: the bridge has no {}", #name);                                                                  \
+    required_functions_missing = true;                                                                                 \
+  }
+#include "vulkan_entry_points.inl"
+#undef VULKAN_MODULE_ENTRY_POINT
+
+  if (required_functions_missing)
+  {
+    ResetVulkanLibraryFunctionPointers();
+    Error::SetStringView(error, "Chimera's Vulkan bridge lacks a function this renderer cannot do without");
+    return false;
+  }
+
+  s_chimera_vulkan_loaded = true;
+  return true;
+}
