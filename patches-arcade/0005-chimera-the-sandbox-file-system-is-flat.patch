+#ifdef CHIMERA_FLAT_FILESYSTEM
+// chimera: in a sandbox the file system is FLAT, and READ ONLY.
+//
+// A waterbox guest sees exactly the files the frontend mounted, each under its
+// own name, and there are no directories at all - so a path is its last
+// component and nothing else. DuckStation builds paths the way a desktop does
+// (a data root, a folder per kind of file, then the name), which produces
+// "./bios" for a file mounted as "bios", and the open fails.
+//
+// Rather than teach every caller, the reduction happens here, at the places
+// where a path stops being a string and becomes a file. There is one
+// directory, everything is in it, and its name never appears.
+//
+// Nothing is written through a path either: there is no disk, and a core
+// that could leave something behind is a core whose next run starts from a
+// different machine. What the console must keep (memory cards) leaves through
+// the frontend's save-data channel instead.
+static bool ChimeraIsWriteMode(const char* mode)
+{
+  for (const char* c = mode; c && *c; c++)
+  {
+    if (*c == 'w' || *c == 'a' || *c == '+')
+      return true;
+  }
+  return false;
+}
+
+// One file may be known by a second name. A file the frontend opened directly
+// is mounted under a fixed name with no extension, and DuckStation decides
+// what a disc image IS by its extension; the embedder looks at the bytes and
+// says what the file should have been called (ChimeraFileAlias).
+static char s_chimera_alias_from[64];
+static char s_chimera_alias_to[64];
+
+extern "C" void ChimeraFileAlias(const char* from, const char* to)
+{
+  std::snprintf(s_chimera_alias_from, sizeof(s_chimera_alias_from), "%s", from ? from : "");
+  std::snprintf(s_chimera_alias_to, sizeof(s_chimera_alias_to), "%s", to ? to : "");
+}
+
+static const char* ChimeraFlatName(const char* path)
+{
+  if (!path)
+    return path;
+
+  const char* last = std::strrchr(path, '/');
+  const char* name = last ? (last + 1) : path;
+  if (s_chimera_alias_from[0] != '\0' && std::strcmp(name, s_chimera_alias_from) == 0)
+    return s_chimera_alias_to;
+  return name;
+}
+
+// the one directory: "", ".", "./", "/" and anything else that names no file
+static bool ChimeraIsRoot(const char* path)
+{
+  const char* name = ChimeraFlatName(path);
+  return (!name || name[0] == '\0' || (name[0] == '.' && name[1] == '\0'));
+}
+#define CHIMERA_FLATTEN(name) name = ChimeraFlatName(name)
+#else
+#define CHIMERA_FLATTEN(name) ((void)0)
+#endif
+
