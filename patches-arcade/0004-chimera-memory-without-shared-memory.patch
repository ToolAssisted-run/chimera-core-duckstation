 bool Bus::AllocateMemoryMap(bool export_shared_memory, Error* error)
 {
+#ifdef CHIMERA_NO_SHARED_MEMORY
+  // Upstream maps one shared memory object twice, so that RAM has a view a
+  // page of which can be write-protected and another that never is. A sandbox
+  // has no such object and cannot protect a page for its guest, so there is
+  // one view of each region, from the heap, and it is always writable: code
+  // that was compiled from a page is found by the check every writer already
+  // makes (g_ram_code_bits), never by a fault.
+  g_ram = static_cast<u8*>(Common::AlignedMalloc(MemoryMap::RAM_SIZE, HOST_PAGE_SIZE));
+  g_bios = static_cast<u8*>(Common::AlignedMalloc(MemoryMap::BIOS_SIZE, HOST_PAGE_SIZE));
+  g_memory_handlers = static_cast<void**>(Common::AlignedMalloc(MemoryMap::LUT_SIZE, HOST_PAGE_SIZE));
+  if (!g_ram || !g_bios || !g_memory_handlers)
+  {
+    Error::SetStringView(error, "Failed to allocate memory for RAM, BIOS and LUTs");
+    ReleaseMemoryMap();
+    return false;
+  }
+
+  std::memset(g_ram, 0, MemoryMap::RAM_SIZE);
+  std::memset(g_bios, 0, MemoryMap::BIOS_SIZE);
+  std::memset(g_memory_handlers, 0, MemoryMap::LUT_SIZE);
+  g_unprotected_ram = g_ram;
+  g_memory_handlers_isc = g_memory_handlers + MEMORY_LUT_SLOTS;
+  SetHandlers();
+  Exports::RAM = reinterpret_cast<uintptr_t>(g_unprotected_ram);
+  return true;
+#else
   INFO_LOG("Allocating{} shared memory map.", export_shared_memory ? " EXPORTED" : "");
   if (export_shared_memory)
   {
@@ -269,6 +295,7 @@ bool Bus::AllocateMemoryMap(bool export_shared_memory, Error* error)
 #endif
 
   return true;
+#endif // CHIMERA_NO_SHARED_MEMORY
 }
 
