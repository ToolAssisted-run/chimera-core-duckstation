+  g_memory_handlers_isc = nullptr;
+  Common::AlignedFree(g_memory_handlers);
+  g_memory_handlers = nullptr;
+  Common::AlignedFree(g_bios);
+  g_bios = nullptr;
+  Common::AlignedFree(g_ram);
+  g_ram = nullptr;
+  g_unprotected_ram = nullptr;
+  return;
+#endif
+
   g_memory_handlers_isc = nullptr;
