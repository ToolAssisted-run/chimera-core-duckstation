  "settings": [
    {
      "name": "bios",
      "display": "BIOS",
      "type": "enum",
      "options": [
        "v1.0-j",
        "v1.1-j",
        "v2.0-a",
        "v2.0-e",
        "v2.1-a",
        "v2.1-e",
        "v2.1-j",
        "v2.2-a",
        "v2.2-e",
        "v2.2-j",
        "v3.0-a",
        "v3.0-e",
        "v3.0-j",
        "v4.0-j",
        "v4.1-a",
        "v4.1-e",
        "v4.3-j",
        "v4.4-e",
        "v4.5-a",
        "v4.5-e"
      ],
      "default": "v4.1-a",
      "description": "Which of Sony's boot ROMs the console has. It is the machine's operating system and it differs by region and by revision - 'v4.1-a' is version 4.1 for North America (the SCPH-7001's), a 'j' is Japan's and an 'e' is Europe's - so a project pins one and the frontend asks for that dump. A game runs on any of them that will accept its disc; a movie is of one."
    },
    {
      "name": "region",
      "display": "Console Region",
      "type": "enum",
      "options": [
        "auto",
        "ntsc-u",
        "ntsc-j",
        "pal"
      ],
      "default": "auto",
      "description": "Which market the console was made for: it decides the video timing (NTSC 59.83Hz, PAL 49.76Hz) and which discs the drive accepts. 'auto' reads the disc and becomes the console it was pressed for, which is right for almost everything; with no disc it is the console its BIOS was made for."
    },
    {
      "name": "port1",
      "display": "Controller 1",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock"
      ],
      "default": "dualshock",
      "description": "What port 1 holds. 'dualshock' is the analog controller, in the mode it powers on in; 'digital' is the original pad with no sticks. A game the database says cannot work with a DualShock is given the digital pad whatever this says."
    },
    {
      "name": "port2",
      "display": "Controller 2",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock"
      ],
      "default": "none",
      "description": "What port 2 holds. Nothing, by default: a pad that is plugged in is a pad a game can see."
    },
    {
      "name": "memcard1",
      "display": "Memory Card 1",
      "type": "bool",
      "default": true,
      "description": "A memory card in slot 1. It lives in the console's memory: it is in every savestate and rewinds with the game that wrote to it, and nothing is written to your disk until you ask (Emulator > Export Save Data, which gives you memcard1.mcd). To start from a card you already have, put it in the project's Save Data under that name."
    },
    {
      "name": "memcard2",
      "display": "Memory Card 2",
      "type": "bool",
      "default": false,
      "description": "A memory card in slot 2, the same way: memcard2.mcd."
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl",
        "opengl-hw"
      ],
      "default": "software",
      "description": "What draws the picture. 'software' is DuckStation's software rasteriser: the console's own pixels, and the default. 'opengl' is its hardware renderer - the one with Internal Resolution - drawn by an OpenGL that is compiled into the core (Mesa's softpipe): no graphics card is involved, so it draws the same picture on every machine, and it is slow. 'opengl-hw' is that same renderer drawing on this computer's graphics card, which is fast and is NOT the same on every machine: a card and its driver are outside the core, and a movie made this way carries no promise that it replays elsewhere. Without a card the softpipe draws instead. To a game that reads its own picture back the three are different machines, so a project pins the choice."
    },
    {
      "name": "internalResolution",
      "display": "Internal Resolution",
      "type": "enum",
      "options": [
        "1x",
        "2x",
        "3x",
        "4x",
        "5x",
        "6x",
        "7x",
        "8x"
      ],
      "default": "1x",
      "description": "How many pixels the hardware renderer draws for each of the console's. 2x of a 320x240 game is 640x480; 8x is 2560x1920. Polygons are drawn sharper; 2D art is the size it was made at. It does nothing with the software renderer. A game that reads its picture back gets it scaled down again, which is not always what it drew - so this too is part of the machine a movie is made on.",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw"
        ]
      }
    },
    {
      "name": "trueColor",
      "display": "True Colour",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw"
        ]
      },
      "description": "Draw in 24-bit colour instead of the console's 15-bit with dithering. Gradients lose their banding and their dither pattern. DuckStation turns this on by default; here the console's own colour depth is the default and this is the enhancement. A game that reads its picture back gets it cut down to 15-bit again."
    },
    {
      "name": "scaledDithering",
      "display": "Scale Dithering",
      "type": "bool",
      "default": true,
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw"
        ]
      },
      "description": "With True Colour off and an Internal Resolution above 1x: make the dither pattern as fine as the picture, rather than the console's pattern enlarged. No effect at 1x."
    },
    {
      "name": "textureFiltering",
      "display": "Texture Filtering",
      "type": "enum",
      "options": [
        "nearest",
        "bilinear",
        "bilinearBinAlpha",
        "jinc2",
        "jinc2BinAlpha",
        "xbr",
        "xbrBinAlpha"
      ],
      "default": "nearest",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw"
        ]
      },
      "description": "How textures on 3D polygons are sampled. 'nearest' is the console: each texel a square. 'bilinear' blends neighbours; 'jinc2' and 'xbr' are sharper and slower. The 'BinAlpha' forms keep transparency edges hard, which stops the halos filtering otherwise draws around cut-out textures."
    },
    {
      "name": "spriteTextureFiltering",
      "display": "Sprite Texture Filtering",
      "type": "enum",
      "options": [
        "nearest",
        "bilinear",
        "bilinearBinAlpha",
        "jinc2",
        "jinc2BinAlpha",
        "xbr",
        "xbrBinAlpha"
      ],
      "default": "nearest",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw"
        ]
      },
      "description": "The same choice for 2D sprites and backgrounds, which are usually better left as the artist drew them."
    },
    {
      "name": "downsampling",
      "display": "Downsampling",
      "type": "enum",
      "options": [
        "disabled",
        "box",
        "adaptive"
      ],
      "default": "disabled",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw"
        ]
      },
      "description": "Draw at the Internal Resolution and then shrink the picture handed over. 'box' averages everything back to the console's resolution; 'adaptive' keeps 3D sharp and smooths only 2D. 'disabled' hands over every pixel that was drawn."
    },
    {
      "name": "pgxp",
      "display": "PGXP Geometry Correction",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw"
        ]
      },
      "description": "Keep polygon corners at the precision the game computed them at, instead of the whole pixels the console rounded them to. This is what stops 3D models wobbling. It is not only a picture setting: which polygons are thrown away is decided with the precise corners too, and how long the console's graphics chip is busy follows from what it drew - so a game runs a little differently with it, and a movie made with PGXP does not play without it."
    },
    {
      "name": "pgxpTextureCorrection",
      "display": "PGXP: Perspective Correct Textures",
      "type": "bool",
      "default": true,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Use the depth PGXP recovers to map textures in perspective, which straightens the warping the console's affine mapping gives large polygons."
    },
    {
      "name": "pgxpColorCorrection",
      "display": "PGXP: Perspective Correct Colours",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "The same for shading. Usually subtle, and wrong in a few games."
    },
    {
      "name": "pgxpCulling",
      "display": "PGXP: Culling Correction",
      "type": "bool",
      "default": true,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Decide which polygons face away using the precise corners too, which closes the hairline gaps precise corners otherwise open."
    },
    {
      "name": "pgxpDepthBuffer",
      "display": "PGXP: Depth Buffer",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Give polygons a depth test, which the console did not have, to stop them poking through each other. It breaks games that draw in an order of their own. The depth of a frame is not carried in a state: after a load it starts empty, as it does every frame the game clears it."
    },
    {
      "name": "pgxpCpu",
      "display": "PGXP: CPU Mode",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Track precise values through every processor instruction instead of only through the geometry chip. A few games need it; it is much slower."
    },
    {
      "name": "crop",
      "display": "Crop",
      "type": "enum",
      "options": [
        "overscan",
        "none",
        "borders"
      ],
      "default": "overscan",
      "description": "How much of the console's raster is handed over. 'overscan' cuts what a television's edge hid; 'none' keeps the whole raster, black edges included; 'borders' cuts to the picture the game placed. It is the picture's edge and nothing the machine can see."
    },
    {
      "name": "interlacing",
      "display": "Interlaced Modes",
      "type": "enum",
      "options": [
        "weave",
        "progressive"
      ],
      "default": "weave",
      "description": "What happens in the console's interlaced video modes (480 lines; most menus and a good many games). 'weave' is the console: each frame it draws and shows one field, every other line, and the frame handed over is that field woven with the one before, as a television showed it. 'progressive' is DuckStation's own default and an enhancement: every line is drawn every frame, which is a steadier picture and a different machine, because what is in video memory is no longer what a PlayStation would have put there."
    },
    {
      "name": "fast_boot",
      "display": "Skip the Console Boot",
      "type": "bool",
      "default": false,
      "description": "Start the game without the console's own logos. The ROM is patched to jump past them, so the machine reaches the game in a different state from one that booted in full - a movie made one way does not play the other."
    },
    {
      "name": "verbose",
      "display": "Log the Machine",
      "type": "bool",
      "default": false,
      "description": "Write DuckStation's own log, and what it would have shown on screen, to the core's output. It changes nothing about the machine."
    }
  ],
