    {
      "id": "bios",
      "display": "PlayStation BIOS",
      "description": "The console's 512 KB boot ROM, copied from a PlayStation you own. This project asks for version 2.1 for Japan, the ROM of the SCPH-3500. Another copy of the same version is accepted. A different version is a different machine, and you choose it with the BIOS setting.",
      "size": 524288,
      "name": "PSX_2.1(J).bin",
      "sha1": "E38466A4BA8005FBA7E9E3C7B9EFEBA7205BEE3F",
      "label": "SCPH-3500 (v2.1 07-17-95 J)",
      "requiredWhen": {
