      "default": "playstation",
      "description": "Which machine this project is: the PlayStation, or one of the arcade boards built from PlayStation hardware. A PlayStation runs discs. An arcade board runs a MAME rom set, and each board runs only the sets made for it. Everything else follows from this choice: the files, the controls and the firmware."
    },
    {
      "name": "bios",
      "display": "BIOS",
      "type": "enum",
      "options": [
        "v1.0-j",
        "v1.1-j",
        "v2.0-a",
        "v2.0-e",
        "v2.1-a",
        "v2.1-e",
        "v2.1-j",
        "v2.2-a",
        "v2.2-e",
        "v2.2-j",
        "v3.0-a",
        "v3.0-e",
        "v3.0-j",
        "v4.0-j",
        "v4.1-a",
        "v4.1-e",
        "v4.3-j",
        "v4.4-e",
        "v4.5-a",
        "v4.5-e"
      ],
      "default": "v4.1-a",
      "description": "Which of Sony's boot ROMs the console has. The boot ROM is the machine's operating system. It differs by region and by revision. For example 'v4.1-a' is version 4.1 for North America (the one in the SCPH-7001), a 'j' is for Japan and an 'e' is for Europe. A project records one of them, and Chimera asks for that file. A game runs on any BIOS that accepts its disc, but a movie plays back only on the one it was made with.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "region",
      "display": "Console Region",
      "type": "enum",
      "options": [
        "auto",
        "ntsc-u",
        "ntsc-j",
        "pal"
      ],
      "default": "auto",
      "description": "Which market the console was made for. It decides the video timing (NTSC 59.83 Hz or PAL 49.76 Hz) and which discs the drive accepts. 'auto' reads the disc and becomes the console that disc was made for, which is right for almost every game. With no disc it becomes the console its BIOS was made for.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port1",
      "display": "Controller 1",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "dualshock",
      "description": "What is plugged into port 1. 'dualshock' is the analog controller, in the mode it starts in when switched on. 'digital' is the original pad with no sticks. 'analogJoystick' is the flight controller with two sticks. 'negcon' is Namco's twisting pad for racing games, and 'negconRumble' is the later one with motors. 'guncon' and 'justifier' are the two light guns. They are not interchangeable, and a game works with one or the other. 'mouse' is the PlayStation Mouse. DuckStation's game database lists games that cannot work with a DualShock. Such a game gets the digital pad whatever is chosen here.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port2",
      "display": "Controller 2",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "none",
      "description": "What is plugged into port 2. By default nothing is, because a game can see any controller that is plugged in. 'dualshock' is the analog controller, in the mode it starts in when switched on. 'digital' is the original pad with no sticks. 'analogJoystick' is the flight controller with two sticks. 'negcon' is Namco's twisting pad for racing games, and 'negconRumble' is the later one with motors. 'guncon' and 'justifier' are the two light guns. They are not interchangeable, and a game works with one or the other. 'mouse' is the PlayStation Mouse. DuckStation's game database lists games that cannot work with a DualShock. Such a game gets the digital pad whatever is chosen here.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "multitap",
      "display": "Multitap",
      "type": "enum",
      "options": [
        "none",
        "port1",
        "port2",
        "both"
      ],
      "default": "none",
      "description": "A multitap turns one controller port into four sockets, for games of up to five players (one multitap) or eight (two). 'port1' puts a multitap in port 1. Controller 1 is then its socket A, and Controllers 1B, 1C and 1D are its other three sockets. A game that was not written for the multitap may not see ANY controller through it, so leave it out unless the game asks for one. It is part of the machine, so a movie needs the same value.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port1b",
      "display": "Controller 1B",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "none",
      "description": "What is plugged into socket B of the multitap in port 1 (P3 in a movie). It is empty unless that multitap is plugged in.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port1c",
      "display": "Controller 1C",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "none",
      "description": "What is plugged into socket C of the multitap in port 1 (P4 in a movie). It is empty unless that multitap is plugged in.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port1d",
      "display": "Controller 1D",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "none",
      "description": "What is plugged into socket D of the multitap in port 1 (P5 in a movie). It is empty unless that multitap is plugged in.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port2b",
      "display": "Controller 2B",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "none",
      "description": "What is plugged into socket B of the multitap in port 2 (P6 in a movie). It is empty unless that multitap is plugged in.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port2c",
      "display": "Controller 2C",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "none",
      "description": "What is plugged into socket C of the multitap in port 2 (P7 in a movie). It is empty unless that multitap is plugged in.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "port2d",
      "display": "Controller 2D",
      "type": "enum",
      "options": [
        "none",
        "digital",
        "dualshock",
        "analogJoystick",
        "negcon",
        "negconRumble",
        "guncon",
        "justifier",
        "mouse"
      ],
      "default": "none",
      "description": "What is plugged into socket D of the multitap in port 2 (P8 in a movie). It is empty unless that multitap is plugged in.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "memcard1",
      "display": "Memory Card 1",
      "type": "bool",
      "default": true,
      "description": "Puts a memory card in slot 1. The card is kept in the console's memory. It is part of every savestate and goes back in time together with the game that wrote to it. Nothing is written to your disk until you ask for it with Emulator > Export Save Data, which gives you memcard1.mcd. To start from a card you already have, put it in the project's Save Data under that name.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "memcard2",
      "display": "Memory Card 2",
      "type": "bool",
      "default": false,
      "description": "Puts a memory card in slot 2. It works the same way as Memory Card 1, and its file is memcard2.mcd.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "renderer",
      "display": "Renderer",
      "type": "enum",
      "options": [
        "software",
        "opengl",
        "opengl-hw",
        "vulkan-hw"
      ],
      "default": "software",
      "description": "What draws the picture. 'software' is DuckStation's software renderer. It draws the console's own pixels and is the default. 'opengl' is DuckStation's hardware renderer, the one that Internal Resolution applies to, drawn by an OpenGL that is built into the core (Mesa's softpipe). No graphics card is used, so the picture is the same on every computer, and it is slow. 'opengl-hw' is that same renderer drawing on your computer's graphics card. This is fast, but it is NOT the same on every computer, because the card and its driver are outside the core. A movie made this way may not play back on another computer. If there is no graphics card, the softpipe draws instead. 'vulkan-hw' is the same renderer again, drawing on your graphics card with Vulkan instead of OpenGL. Like 'opengl-hw' it is fast and not the same on every computer. It has nothing to fall back on: on a computer with no Vulkan driver the game does not start, and says why. A game that reads its own picture back sees a different machine with each of these, so a project records the choice."
    },
    {
      "name": "internalResolution",
      "display": "Internal Resolution",
      "type": "enum",
      "options": [
        "1x",
        "2x",
        "3x",
        "4x",
        "5x",
        "6x",
        "7x",
        "8x",
        "9x",
        "10x",
        "11x",
        "12x",
        "13x",
        "14x",
        "15x",
        "16x"
      ],
      "default": "1x",
      "description": "How many pixels the hardware renderer draws for each pixel of the console. At 2x a 320x240 game is drawn at 640x480, and at 16x at 5120x3840. Polygons become sharper, and 2D art stays the size it was made at. It does nothing with the software renderer. A game that reads its picture back gets it scaled down again, and that is not always exactly what it drew. So it is part of the machine, and a movie needs the same value.",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw",
          "vulkan-hw"
        ]
      }
    },
    {
      "name": "trueColor",
      "display": "True Colour",
      "type": "bool",
      "default": true,
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw",
          "vulkan-hw"
        ]
      },
      "description": "Draws in 24-bit colour instead of the console's 15-bit colour with dithering. Gradients lose their bands and their dither pattern. It is on by default, as DuckStation has it; off is the console's own colour depth. A game that reads its picture back gets it reduced to 15-bit again. A project made before 2026-10-19 recorded off and keeps it."
    },
    {
      "name": "scaledDithering",
      "display": "Scale Dithering",
      "type": "bool",
      "default": true,
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw",
          "vulkan-hw"
        ]
      },
      "description": "Makes the dither pattern as fine as the picture, instead of the console's pattern enlarged. It applies when True Colour is off and Internal Resolution is above 1x. It has no effect at 1x."
    },
    {
      "name": "textureFiltering",
      "display": "Texture Filtering",
      "type": "enum",
      "options": [
        "nearest",
        "bilinear",
        "bilinearBinAlpha",
        "jinc2",
        "jinc2BinAlpha",
        "xbr",
        "xbrBinAlpha"
      ],
      "default": "nearest",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw",
          "vulkan-hw"
        ]
      },
      "description": "How the textures on 3D polygons are sampled. 'nearest' is what the console does: each texture pixel is a square. 'bilinear' blends neighbouring pixels. 'jinc2' and 'xbr' are sharper and slower. The 'BinAlpha' choices keep the edges of transparent areas hard, which avoids the halos that filtering otherwise draws around cut-out textures."
    },
    {
      "name": "spriteTextureFiltering",
      "display": "Sprite Texture Filtering",
      "type": "enum",
      "options": [
        "nearest",
        "bilinear",
        "bilinearBinAlpha",
        "jinc2",
        "jinc2BinAlpha",
        "xbr",
        "xbrBinAlpha"
      ],
      "default": "nearest",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw",
          "vulkan-hw"
        ]
      },
      "description": "The same choice for 2D sprites and backgrounds. These usually look better as the artist drew them."
    },
    {
      "name": "downsampling",
      "display": "Downsampling",
      "type": "enum",
      "options": [
        "disabled",
        "box",
        "adaptive"
      ],
      "default": "disabled",
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw",
          "vulkan-hw"
        ]
      },
      "description": "Draws at the Internal Resolution and then shrinks the picture that is handed to Chimera. 'box' averages everything back to the console's resolution. 'adaptive' keeps 3D sharp and smooths only 2D. 'disabled' hands over every pixel that was drawn."
    },
    {
      "name": "pgxp",
      "display": "PGXP Geometry Correction",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "renderer",
        "in": [
          "opengl",
          "opengl-hw",
          "vulkan-hw"
        ]
      },
      "description": "Keeps the corners of polygons at the precision the game calculated, instead of rounding them to whole pixels as the console did. This is what stops 3D models from wobbling. It does not change the picture only. The precise corners also decide which polygons are thrown away, and how long the console's graphics chip is busy depends on what it drew. So a game runs slightly differently with it, and a movie made with PGXP does not play back without it."
    },
    {
      "name": "pgxpTextureCorrection",
      "display": "PGXP: Perspective Correct Textures",
      "type": "bool",
      "default": true,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Uses the depth that PGXP recovers to map textures in perspective. This straightens the warped textures that the console's simpler mapping gives large polygons."
    },
    {
      "name": "pgxpColorCorrection",
      "display": "PGXP: Perspective Correct Colours",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "The same for shading. The difference is usually small, and it is wrong in a few games."
    },
    {
      "name": "pgxpCulling",
      "display": "PGXP: Culling Correction",
      "type": "bool",
      "default": true,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Also uses the precise corners to decide which polygons face away. This closes the hairline gaps that precise corners otherwise open."
    },
    {
      "name": "pgxpDepthBuffer",
      "display": "PGXP: Depth Buffer",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Gives polygons a depth test, which the console did not have, to stop them poking through each other. It breaks games that draw in an order of their own. The depth of a frame is not kept in a savestate. After a load it starts empty, as it does on every frame where the game clears it."
    },
    {
      "name": "pgxpCpu",
      "display": "PGXP: CPU Mode",
      "type": "bool",
      "default": false,
      "exposedWhen": {
        "setting": "pgxp",
        "is": true
      },
      "description": "Tracks precise values through every processor instruction, and not only through the geometry chip. A few games need it. It is much slower."
    },
    {
      "name": "widescreen",
      "display": "Widescreen Hack",
      "type": "enum",
      "options": [
        "off",
        "16:9",
        "19:9",
        "20:9"
      ],
      "default": "off",
      "description": "DuckStation's widescreen hack. The game's 3D view is widened to suit a screen of this shape, by changing what its geometry processor calculates. The picture is still the console's own, squeezed. Set Config > Display > Aspect Ratio to the same shape to see it as intended. The 2D parts of a game (menus, status displays, sprites) are not widened and look stretched. It changes the MACHINE and not only the picture: different geometry is drawn, and that takes the video chip a different time. So a movie made with it needs it. DuckStation's game database lists games that break with it, and for those it is turned off.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "crop",
      "display": "Crop",
      "type": "enum",
      "options": [
        "overscan",
        "none",
        "borders"
      ],
      "default": "overscan",
      "description": "How much of the console's picture is handed to Chimera. 'overscan' cuts off what the edge of a television hid. 'none' keeps the whole picture, black edges included. 'borders' cuts to the area the game placed its picture in. It changes the picture only."
    },
    {
      "name": "interlacing",
      "display": "Interlaced Modes",
      "type": "enum",
      "options": [
        "weave",
        "progressive"
      ],
      "default": "progressive",
      "description": "What happens in the console's interlaced video modes (480 lines, used by most menus and by many games). 'progressive' is the default, as DuckStation has it: every line is drawn on every frame, a steadier picture. 'weave' is what the console does: on each frame it draws and shows one field, which is every other line, and the frame handed to Chimera is that field combined with the previous one, as a television showed it. The two are different machines, because video memory holds other lines, so a movie needs the same value. A project made before 2026-10-19 recorded 'weave' and keeps it."
    },
    {
      "name": "fast_boot",
      "display": "Skip the Console Boot",
      "type": "bool",
      "default": false,
      "description": "Starts the game without the console's own logos. The ROM is patched to jump past them, so the machine reaches the game in a different state from one that started in full. A movie made one way does not play back the other way.",
      "when": [
        "playstation"
      ]
    },
    {
      "name": "verbose",
      "display": "Log the Machine",
      "type": "bool",
      "default": false,
      "description": "Writes DuckStation's own log, and the messages it would have shown on screen, to the core's output. It does not change the machine."
    }
  ],
