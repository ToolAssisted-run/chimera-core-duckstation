    {
      "id": "namcoc76.zip",
      "display": "Namco C76 sound processor",
      "description": "The program inside the sound processor that every Namco System 11 board has (the C76, a Mitsubishi M37702). The file is namcoc76.zip as MAME names it, with c76.bin inside. It is a MAME set and is used whole. The core reads the rom out of it and checks that rom by its own CRC and SHA-1. No size or hash of the zip itself is required, because zips of the same rom differ.",
      "name": "namcoc76.zip",
      "requiredWhen": {
        "setting": "machine",
        "is": "namco_system11"
      }
    }
  ]
